# Copy to .env (git-ignored). Never commit real values.
# SEC asks automated clients for a descriptive User-Agent with contact details.
SEC_USER_AGENT="Your Name your.email@example.org"

# OpenRouter key for the agents and the judge (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Approval tokens are HMACs with this secret; set a long random value outside development.
APPROVAL_SECRET=change-me-to-a-long-random-string

# name:token pairs for the API (Authorization: Bearer <token>)
ANALYST_TOKENS=analyst:dev-token

# Optional: LangSmith tracing in addition to the local JSONL traces
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=analyst-desk
